# Autonomous QC & Project Audit Intelligence Platform v1.0
QC_APP_ENV=development
QC_API_HOST=127.0.0.1
QC_API_PORT=8000

# PostgreSQL 18 (Dedicated Local Cluster on Port 5433)
QC_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/qc_platform
QC_SYNC_DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5433/qc_platform
QC_REDIS_URL=redis://127.0.0.1:6379/0

# Security & JWT
QC_JWT_SECRET_KEY=replace-with-strong-32-byte-secret-in-production
QC_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Execution & Evidence Vault
QC_DEFAULT_EXECUTION_MODE=LOCAL
QC_ARTIFACT_STORAGE_ROOT=.qc_artifacts
QC_WORKSPACE_STORAGE_ROOT=.qc_workspaces
QC_COMMAND_TIMEOUT_SECONDS=120

# Multi-Provider AI Gateway (Ollama Local First -> Gemini -> OpenAI -> Deterministic AST Fallback)
QC_DEFAULT_LLM_PROVIDER=ollama
QC_OLLAMA_BASE_URL=http://127.0.0.1:11434
QC_OLLAMA_MODEL=qwen2.5-coder:7b
QC_GEMINI_API_KEY=
QC_GEMINI_MODEL=gemini-2.5-flash
QC_OPENAI_API_KEY=
QC_OPENAI_MODEL=gpt-4o-mini
